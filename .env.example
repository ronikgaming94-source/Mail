# Telegram BotFather token. Store this as a Replit Secret.
BOT_TOKEN=

# Replit injects DATABASE_URL for the PostgreSQL database.
DATABASE_URL=

# Comma-separated numeric Telegram user IDs. Never use usernames for admin access.
ADMIN_IDS=713914937

# Fernet key or any high-entropy value. Store this as a Replit Secret.
ENCRYPTION_KEY=

SUPPORT_BOT_URL=https://t.me/HelpSupportteambot
PORT=8000

# Free provider pool. Mail.tm is primary and Mail.gw is the automatic fallback.
MAILTM_API_BASE=https://api.mail.tm
MAILTM_HUB_URL=https://mercure.mail.tm/.well-known/mercure
MAILTM_FALLBACK_API_BASE=https://api.mail.gw
MAILTM_RATE_PER_SECOND=1.0

# Keep 20 unassigned mailboxes ready; refill when stock drops below 10.
MAILBOX_POOL_TARGET=20
MAILBOX_POOL_REFILL_THRESHOLD=10
MAILBOX_POOL_REFILL_INTERVAL=10
