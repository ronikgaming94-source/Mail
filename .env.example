# Telegram BotFather token. Store this as a Replit Secret.
BOT_TOKEN=

# Replit injects DATABASE_URL for the PostgreSQL database.
DATABASE_URL=

# Comma-separated numeric Telegram user IDs. Never use usernames for admin access.
ADMIN_IDS=713914937

# Fernet key or any high-entropy value. Store this as a Replit Secret.
ENCRYPTION_KEY=

SUPPORT_BOT_URL=https://t.me/HelpSupportteambot
PORT=8000
